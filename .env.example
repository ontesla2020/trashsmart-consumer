# Copy to .env and fill in. Without a key, the server returns a realistic CANNED
# detection (blueberries in a plastic clamshell) so the UI works end-to-end.

OPENAI_API_KEY=
VISION_MODEL=gpt-4o-mini
PORT=8788

# Shared rules store — use the SAME Supabase project as the Inspector app so
# consumer guidance follows the rules inspectors define. Blank = in-memory defaults.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Base URL of the deployed API, used by the frontend build. Leave blank for
# local dev and for web/PWA deploys (frontend + API share an origin). Set this
# when building for a native app shell (Capacitor), which has no "same origin"
# to fall back on — e.g. VITE_API_URL=https://api.trashsmart.ai
VITE_API_URL=
